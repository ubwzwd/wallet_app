# Database Configuration
DATABASE_URL=postgresql://wallet_user:wallet_password@localhost:5432/wallet_db

# JWT Configuration
# Generate a real value with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_VIA_openssl_rand_-hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=Wallet App API
DEBUG=True

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Exchange Rate API (Frankfurter - ECB data, no key required)
EXCHANGE_RATE_API_URL=https://api.frankfurter.dev/v1

# Environment
ENVIRONMENT=development

# Registration switch (decision §0.5) — set false to close signups
REGISTRATION_OPEN=true

# Statement import (decision §5) — standard CSV only, never stored on disk
MAX_UPLOAD_MB=2
IMPORT_MAX_ROWS=2000

# Exchange rates (decision §8)
FX_HTTP_TIMEOUT_SECONDS=10

# Rate limits (decision §2, §9, §14.35, §14.43)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_JOIN_QPS=1
RATE_LIMIT_IMPORTS_PER_HOUR=10

# Soft limits (decision §2)
MAX_LEDGERS_PER_USER=10
MAX_MEMBERS_PER_LEDGER=10

