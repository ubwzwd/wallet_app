    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^54.0.6",
    "jest": "^30.3.0",
    "jest-expo": "^55.0.13",
    "sharp": "^0.33.5",
    "typescript": "~5.9.2",
    "workbox-cli": "^7.4.1"
  },
  "private": true
