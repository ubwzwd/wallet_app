# infra/.env.example - production-shape compose env template (v3)
#
# USAGE:
#   1. cp infra/.env.example infra/.env
#   2. Replace every CHANGE_ME_* placeholder with a real value
#      (and rebuild DATABASE_URL from the Postgres values, see below).
#   3. chmod 600 infra/.env
#
# NOTE: infra/.env is gitignored. This file (.env.example) IS committed and is the schema:
#       infra/scripts/env-coverage.sh checks that it lists every Settings field of
#       backend/app/core/config.py (except API_V1_PREFIX / PROJECT_NAME, which keep their defaults).
#       CHANGE_ME_* values are sentinels, not defaults, so a missed substitution is easy to grep for:
#       grep CHANGE_ME infra/.env

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=wallet
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=wallet

# Database URL consumed by the backend. The host is the compose service name `db`,
# NOT localhost. Write the FULL value: pydantic-settings does not expand ${...}, and
# relying on compose's env_file interpolation (v2.24+) is not worth the risk.
# Filled-in example (user=wallet, db=wallet, password=s3cretpass):
#   DATABASE_URL=postgresql://wallet:s3cretpass@db:5432/wallet
# Use a URL-safe password (letters and digits, e.g. `openssl rand -hex 24`).
DATABASE_URL=postgresql://wallet:CHANGE_ME_POSTGRES_PASSWORD@db:5432/wallet

# --- Auth ---------------------------------------------------------------------
# Required, no default. Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh tokens expire after this many idle days; every refresh extends it
REFRESH_TOKEN_EXPIRE_DAYS=90

# --- App ----------------------------------------------------------------------
DEBUG=false
ENVIRONMENT=production
# Comma-separated; set to the public https origin (defense in depth, the SPA is same-origin).
ALLOWED_ORIGINS=https://CHANGE_ME_YOUR_DOMAIN
# Exchange-rate API (Frankfurter, ECB data, no key required)
EXCHANGE_RATE_API_URL=https://api.frankfurter.dev/v1
# Registration switch (decision 0.5): set false to close signups
REGISTRATION_OPEN=true

# --- Limits and rate limits ---------------------------------------------------
# Statement import: standard CSV only, never stored on disk
MAX_UPLOAD_MB=2
IMPORT_MAX_ROWS=2000
FX_HTTP_TIMEOUT_SECONDS=10
# In-process token buckets (single uvicorn process by design), keyed by X-Forwarded-For first hop
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_JOIN_QPS=1
RATE_LIMIT_IMPORTS_PER_HOUR=10
# Soft limits
MAX_LEDGERS_PER_USER=10
MAX_MEMBERS_PER_LEDGER=10
MAX_SOURCES_PER_USER=50

# --- Caddy --------------------------------------------------------------------
# Public hostname (DuckDNS: xxx.duckdns.org, or <ip>.sslip.io). Must match ALLOWED_ORIGINS.
# localhost / an IP gets a certificate from Caddy's internal CA; a real domain gets ACME.
CADDY_DOMAIN=CHANGE_ME_YOUR_DOMAIN
# Optional. ACME directory; unset or empty means Let's Encrypt production.
# Use staging for a first bring-up to avoid rate limits:
# CADDY_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# Optional host ports (defaults 80 / 443; the local smoke test uses other ports).
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
# Optional: directory with the built frontend (npm run build:web), relative to infra/.
# WEB_DIST=../frontend/dist

# --- Postgres tuning (optional) ------------------------------------------------
# Defaults (256MB / 1GB) are plenty for a family ledger on a 6 GB VM. For a bigger VM the
# rule of thumb is shared_buffers about 1/4 of RAM, effective_cache_size 1/4 to 1/2 of RAM.
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=1GB
