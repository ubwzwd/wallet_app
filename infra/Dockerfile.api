# syntax=docker/dockerfile:1.6
#
# Production backend image for Wallet App.
#
# Build context is the REPO ROOT (infra/docker-compose.prod.yml uses
# `context: ..` + `dockerfile: infra/Dockerfile.api`), so every COPY path below
# is relative to the repo root:
#   docker build -f infra/Dockerfile.api -t wallet-app/api:local .
# The image carries skills/ next to backend/ because GET /api/v1/import-format
# reads skills/wallet-import from disk (app/api/import_format.py probes
# `<backend dir>/skills/wallet-import`); without it the import guide is blank.
# The repo-root .dockerignore keeps frontend/, docs/, infra/, tests etc. out
# of the context.
#
# Dependencies come from backend/requirements.txt (direct, pinned to the
# versions the backend test suite runs against) plus backend/constraints.txt
# (every transitive package, frozen from a venv that passed the suite), so a
# build on the VM resolves exactly the tested set. All of them ship cp312 wheels
# for amd64 and aarch64 (psycopg2-binary bundles libpq), so the builder needs
# no compiler and the same Dockerfile builds natively on Oracle A1.Flex (ARM64)
# and on an amd64 laptop. The platform is deliberately not pinned here.
#
# uvicorn runs with --proxy-headers --forwarded-allow-ips=* (decision 14.44):
# rate limiting counts per first X-Forwarded-For hop, and without these flags
# every client would look like the Caddy container and 10 failed logins would
# lock out everybody. `*` is safe because api:8000 is never published; only
# Caddy can reach it.
#
# Do NOT add --workers or run a second api replica: the rate limiter is an
# in-process token bucket, so a single uvicorn process is a design premise
# (03 section 8.1). The backend keeps no state on disk, so no volume either.

# ---------------------------------------------------------------------------
# Builder: install pinned dependencies into /install
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS builder

COPY backend/requirements.txt backend/constraints.txt /tmp/
RUN pip install --no-cache-dir --prefix=/install -r /tmp/requirements.txt -c /tmp/constraints.txt

# ---------------------------------------------------------------------------
# Runtime: slim Python + dependencies + app code, non-root
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Order matters: useradd -> WORKDIR -> COPY --from=builder -> COPY --chown ->
# USER. Flipping USER before the final COPY leaves a mix of owners.
RUN useradd -m -u 1000 appuser

WORKDIR /app

COPY --from=builder /install /usr/local

# App code lands at /app so modules stay importable as `app.main`; skills land
# at /app/skills/wallet-import.
COPY --chown=appuser:appuser backend/ .
COPY --chown=appuser:appuser skills/ ./skills/

USER appuser

EXPOSE 8000

# Liveness probe via stdlib urllib, so no extra package is needed in the image.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD python -c "import urllib.request, sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health').status == 200 else 1)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
